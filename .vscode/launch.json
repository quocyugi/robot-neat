// Cấu hình Run and Debug cho buổi demo (Ctrl+Shift+D, chọn cấu hình, rồi Ctrl+F5 để chạy
// hoặc F5 để chạy có debug). Đánh số theo thứ tự chạy trong docs/huong_dan_demo_vscode.md:
// 1 và 9 chạy trước buổi demo để kiểm tra, 2–6 là phần chính, 7–8 chạy thêm nếu còn thời gian.
// PYTHONUTF8=1: Python đọc file (.ini, .json) và in ra terminal bằng UTF-8, không lỗi chữ có dấu.
// Kết quả của các cấu hình ghi vào output/demo/ (thư mục output/ không đưa lên git). Cấu hình 2–9
// ghi thêm ảnh bảng (*_bang.png), ảnh biểu đồ (*_bieu_do.png; cấu hình 6: file --out) và trang HTML
// (*.html); cuối terminal in đường dẫn các file đó (Ctrl+bấm để mở ảnh ngay trong VS Code).
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Kiểm thử các bản sửa lỗi",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_fixes.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "justMyCode": true
    },
    {
      // champion trong demo/ chạy 2 bản đồ test mỗi cấp (8 bản đồ);
      // ảnh kết quả: output/demo/ket_qua_cau_hinh_2_bang.png, _bieu_do.png, .html
      "name": "2. Demo: champion NEAT trên 4 cấp",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo.py",
      "args": ["--levels", "1,2,3,4", "--maps-per-level", "2",
               "--report", "output/demo/ket_qua_cau_hinh_2"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "justMyCode": true
    },
    {
      // baseline APF (B5, không học) trên hai bản đồ cấp 4 đầu tiên của tập test: kẹt ở bẫy chữ U
      "name": "3. Demo: APF kẹt ở bẫy chữ U (cấp 4)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo.py",
      "args": ["--controller", "apf", "--levels", "4", "--maps-per-level", "2",
               "--report", "output/demo/ket_qua_cau_hinh_3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "justMyCode": true
    },
    {
      // SR, CR, hết giờ, SPL, MTT trên 4 cấp test, test_barn và test_lehman (252 bản đồ);
      // ghi test_results.json và test_results_bang.png, test_results_bieu_do.png, test_results.html
      "name": "4. Chấm champion trên toàn bộ tập test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate.py",
      "args": ["--genome", "demo/champion_genome.pkl", "--config", "demo/neat_config.ini",
               "--workers", "4", "--out", "output/demo/test_results.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "justMyCode": true
    },
    {
      // M6 = hồi quy + novelty + curriculum (mặc định của train_neat.py), chỉ 5 thế hệ để xem log;
      // log dạng hình: output/demo/train_m6/training_history_bang.png, _bieu_do.png, .html
      "name": "5. Huấn luyện thử M6 (5 thế hệ)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_neat.py",
      "args": ["--generations", "5", "--workers", "4", "--val-every", "5",
               "--output-dir", "output/demo/train_m6"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "justMyCode": true
    },
    {
      // biểu đồ SR từ kết quả benchmark (docs/benchmark/benchmark_results.json, ghi bằng
      // plot_benchmark.py --json, xem mục 10 của docs/huong_dan_demo_vscode.md);
      // ghi thêm ảnh bảng output/demo/benchmark_sr_bang.png và trang output/demo/benchmark_sr.html
      "name": "6. Vẽ biểu đồ benchmark",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/plot_benchmark.py",
      "args": ["--from-json", "docs/benchmark/benchmark_results.json", "--out", "output/demo/benchmark_sr.png"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "justMyCode": true
    },
    {
      // 4 bản đồ BARN đầu tiên của data/maps/test_barn và 2 mê cung Lehman–Stanley (dữ liệu công khai)
      "name": "7. Demo: champion trên BARN và mê cung Lehman",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo.py",
      "args": ["--maps-per-level", "0", "--barn", "4", "--lehman",
               "--report", "output/demo/ket_qua_cau_hinh_7"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "justMyCode": true
    },
    {
      // cần chạy cấu hình 5 trước
      "name": "8. Xem champion vừa huấn luyện",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo.py",
      "args": ["--run-dir", "output/demo/train_m6", "--levels", "1,2", "--maps-per-level", "1",
               "--report", "output/demo/ket_qua_cau_hinh_8"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "justMyCode": true
    },
    {
      // GIF dự phòng khi máy chiếu không hiện được cửa sổ pygame; chạy lại sau khi thay champion
      "name": "9. Xuất GIF demo (không mở cửa sổ)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo.py",
      "args": ["--no-window", "--save-gif", "output/demo/demo.gif", "--levels", "1,2,3,4",
               "--report", "output/demo/ket_qua_cau_hinh_9"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "justMyCode": true
    }
  ]
}
